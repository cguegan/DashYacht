<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys that the generated Info.plist cannot hold. Other keys are in the build settings. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_signalk-ws._tcp</string>
	</array>
	<!-- Signal K servers on boats use plain HTTP/WS with any host name (openplotter.local, 10.42.0.1, ...). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
